# Copy this file to .env and adjust values as needed.
# .env itself must never be committed.

# General
APP_NAME=JobPulse
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# CORS - comma separated list of allowed origins, or * for all
CORS_ALLOW_ORIGINS=*

# PostgreSQL
POSTGRES_USER=jobpulse
POSTGRES_PASSWORD=jobpulse
POSTGRES_DB=jobpulse
# Use "db" when running via docker-compose, "localhost" when running the
# backend directly on your host machine against a locally installed Postgres.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Job fetchers (Phase 4)
# Greenhouse and Lever are per-company APIs with no public directory -
# list the companies you want checked as comma-separated board
# tokens/slugs (the part of their job board URL after the domain, e.g.
# boards.greenhouse.io/<this> or jobs.lever.co/<this>). Leave blank to
# skip that source entirely.
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANY_SLUGS=
# Remotive and Arbeitnow are general boards covering many companies -
# no per-company configuration needed.
REMOTIVE_CATEGORY=software-dev
ARBEITNOW_MAX_PAGES=1
JOB_FETCH_TIMEOUT_SECONDS=15

# Matching engine (Phase 7) - weights should sum to 1.0
MATCH_WEIGHT_TEXT_SIMILARITY=0.35
MATCH_WEIGHT_SKILLS=0.25
MATCH_WEIGHT_ROLE=0.15
MATCH_WEIGHT_LOCATION=0.10
MATCH_WEIGHT_EXPERIENCE=0.10
MATCH_WEIGHT_REMOTE=0.05
MATCH_TOP_N=20
MATCH_CANDIDATE_POOL_SIZE=1000
